      "workDir": "${REPO_ROOT}",
      "command": ["${GNALLOY_BENCH}", "-protocol", "https1", "-backend", "epoll", "-http1-mode", "raw", "-read-buffer-size", "${GNALLOY_HTTP1_READ_BUFFER_SIZE}", "-payload", "128", "-connections", "${CONNECTIONS}", "-messages", "${MESSAGES}", "-latency-sample-rate", "${LATENCY_SAMPLE_RATE}", "-warmup-messages", "${WARMUP_MESSAGES}", "-alpn", "${HTTP1_ALPN}", "-tls-version", "1.2", "-cipher-suites", "${TLS12_CIPHER}"],
      "timeout": "5m",
      "tags": ["linux", "gnalloy", "https1", "tls12", "payload-128"]
