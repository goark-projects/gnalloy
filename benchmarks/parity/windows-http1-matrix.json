{
  "name": "gnalloy windows http1 parity matrix",
  "notes": "Windows HTTP/1.1 keep-alive 对标矩阵。Gnalloy 固定 IOCP + raw HTTP/1 响应路径；Netty 固定 NIO；gnet 使用 Windows poller。CloudWeGo netpoll v0.7.5 的 Windows server 路径返回 unsupported，不纳入本矩阵。",
  "variables": {
    "REPO_ROOT": ".",
    "CONNECTIONS": "128",
    "MESSAGES": "10000",
    "LATENCY_SAMPLE_RATE": "128",
    "WARMUP_MESSAGES": "1000",
    "GNALLOY_HTTP1_READ_BUFFER_SIZE": "384",
    "GNALLOY_BENCH": "./benchmarks/external/bin/gnalloy-bench",
    "NETTY_BENCH_JAR": "./benchmarks/external/bin/netty-bench.jar",
    "GNET_BENCH": "./benchmarks/external/bin/gnet-bench"
  },
  "scenarios": [
    {
      "name": "gnalloy iocp http1 128B",
      "framework": "gnalloy",
      "protocol": "http1",
      "backend": "iocp",
      "payload": "128B",
      "warmup": 1,
      "repeat": 3,
      "workDir": "${REPO_ROOT}",
      "command": ["${GNALLOY_BENCH}", "-protocol", "http1", "-backend", "iocp", "-http1-mode", "raw", "-read-buffer-size", "${GNALLOY_HTTP1_READ_BUFFER_SIZE}", "-payload", "128", "-connections", "${CONNECTIONS}", "-messages", "${MESSAGES}", "-latency-sample-rate", "${LATENCY_SAMPLE_RATE}", "-warmup-messages", "${WARMUP_MESSAGES}"],
      "timeout": "5m",
      "tags": ["windows", "parity-harness", "http1", "payload-128"]
    },
    {
      "name": "gnalloy iocp http1 1KiB",
      "framework": "gnalloy",
      "protocol": "http1",
      "backend": "iocp",
      "payload": "1024B",
      "warmup": 1,
      "repeat": 3,
      "workDir": "${REPO_ROOT}",
      "command": ["${GNALLOY_BENCH}", "-protocol", "http1", "-backend", "iocp", "-http1-mode", "raw", "-read-buffer-size", "${GNALLOY_HTTP1_READ_BUFFER_SIZE}", "-payload", "1024", "-connections", "${CONNECTIONS}", "-messages", "${MESSAGES}", "-latency-sample-rate", "${LATENCY_SAMPLE_RATE}", "-warmup-messages", "${WARMUP_MESSAGES}"],
      "timeout": "5m",
      "tags": ["windows", "parity-harness", "http1", "payload-1024"]
    },
    {
      "name": "netty nio http1 128B",
      "framework": "netty",
      "protocol": "http1",
      "backend": "nio",
      "payload": "128B",
      "warmup": 1,
      "repeat": 3,
      "command": ["java", "-jar", "${NETTY_BENCH_JAR}", "--protocol", "http1", "--backend", "nio", "--payload", "128", "--connections", "${CONNECTIONS}", "--messages", "${MESSAGES}", "--latency-sample-rate", "${LATENCY_SAMPLE_RATE}", "--warmup-messages", "${WARMUP_MESSAGES}"],
      "timeout": "5m",
      "tags": ["external", "netty", "http1", "payload-128"]
    },
    {
      "name": "netty nio http1 1KiB",
      "framework": "netty",
      "protocol": "http1",
      "backend": "nio",
      "payload": "1024B",
      "warmup": 1,
      "repeat": 3,
      "command": ["java", "-jar", "${NETTY_BENCH_JAR}", "--protocol", "http1", "--backend", "nio", "--payload", "1024", "--connections", "${CONNECTIONS}", "--messages", "${MESSAGES}", "--latency-sample-rate", "${LATENCY_SAMPLE_RATE}", "--warmup-messages", "${WARMUP_MESSAGES}"],
      "timeout": "5m",
      "tags": ["external", "netty", "http1", "payload-1024"]
    },
    {
      "name": "gnet http1 1KiB",
      "framework": "gnet",
      "protocol": "http1",
      "backend": "poller",
      "payload": "1024B",
      "warmup": 1,
      "repeat": 3,
      "command": ["${GNET_BENCH}", "-protocol", "http1", "-payload", "1024", "-connections", "${CONNECTIONS}", "-messages", "${MESSAGES}", "-latency-sample-rate", "${LATENCY_SAMPLE_RATE}", "-warmup-messages", "${WARMUP_MESSAGES}"],
      "timeout": "5m",
      "tags": ["external", "gnet", "http1", "payload-1024"]
    }
  ]
}
