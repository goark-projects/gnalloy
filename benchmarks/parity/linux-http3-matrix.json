{
  "name": "gnalloy linux http3 parity matrix",
  "notes": "Linux HTTP/3 over QUIC 对标矩阵。HTTP/3 按 RFC 9114/RFC 9000 约束固定 TLS 1.3 + ALPN h3；Gnalloy 使用 transport/quic + transport/http3，Netty 使用 epoll + Http3.newQuic*CodecBuilder。gnet/netpoll 没有等价 HTTP/3 协议栈，不纳入本矩阵。",
  "variables": {
    "REPO_ROOT": ".",
    "CONNECTIONS": "64",
    "MESSAGES": "5000",
    "LATENCY_SAMPLE_RATE": "64",
    "WARMUP_MESSAGES": "500",
    "ALPN": "h3",
    "TLS_VERSION": "1.3",
    "GNALLOY_BENCH": "./benchmarks/external/bin/gnalloy-bench",
    "NETTY_BENCH_JAR": "./benchmarks/external/bin/netty-bench.jar"
  },
  "scenarios": [
    {
      "name": "gnalloy rfc9000 h3 128B",
      "framework": "gnalloy",
      "protocol": "http3",
      "backend": "rfc9000",
      "payload": "128B",
      "warmup": 1,
      "repeat": 3,
      "workDir": "${REPO_ROOT}",
      "command": ["${GNALLOY_BENCH}", "-protocol", "http3", "-payload", "128", "-connections", "${CONNECTIONS}", "-messages", "${MESSAGES}", "-latency-sample-rate", "${LATENCY_SAMPLE_RATE}", "-warmup-messages", "${WARMUP_MESSAGES}", "-alpn", "${ALPN}", "-tls-version", "${TLS_VERSION}"],
      "timeout": "5m",
      "tags": ["linux", "parity-harness", "http3", "quic", "tls13", "alpn", "payload-128"]
    },
    {
      "name": "gnalloy rfc9000 h3 1KiB",
      "framework": "gnalloy",
      "protocol": "http3",
      "backend": "rfc9000",
      "payload": "1024B",
      "warmup": 1,
      "repeat": 3,
      "workDir": "${REPO_ROOT}",
      "command": ["${GNALLOY_BENCH}", "-protocol", "http3", "-payload", "1024", "-connections", "${CONNECTIONS}", "-messages", "${MESSAGES}", "-latency-sample-rate", "${LATENCY_SAMPLE_RATE}", "-warmup-messages", "${WARMUP_MESSAGES}", "-alpn", "${ALPN}", "-tls-version", "${TLS_VERSION}"],
      "timeout": "5m",
      "tags": ["linux", "parity-harness", "http3", "quic", "tls13", "alpn", "payload-1024"]
    },
    {
      "name": "netty epoll h3 128B",
      "framework": "netty",
      "protocol": "http3",
      "backend": "epoll",
      "payload": "128B",
      "warmup": 1,
      "repeat": 3,
      "command": ["java", "-jar", "${NETTY_BENCH_JAR}", "--protocol", "http3", "--backend", "epoll", "--payload", "128", "--connections", "${CONNECTIONS}", "--messages", "${MESSAGES}", "--latency-sample-rate", "${LATENCY_SAMPLE_RATE}", "--warmup-messages", "${WARMUP_MESSAGES}", "--alpn", "${ALPN}", "--tls-version", "${TLS_VERSION}"],
      "timeout": "5m",
      "tags": ["linux", "netty", "http3", "quic", "tls13", "alpn", "payload-128"]
    },
    {
      "name": "netty epoll h3 1KiB",
      "framework": "netty",
      "protocol": "http3",
      "backend": "epoll",
      "payload": "1024B",
      "warmup": 1,
      "repeat": 3,
      "command": ["java", "-jar", "${NETTY_BENCH_JAR}", "--protocol", "http3", "--backend", "epoll", "--payload", "1024", "--connections", "${CONNECTIONS}", "--messages", "${MESSAGES}", "--latency-sample-rate", "${LATENCY_SAMPLE_RATE}", "--warmup-messages", "${WARMUP_MESSAGES}", "--alpn", "${ALPN}", "--tls-version", "${TLS_VERSION}"],
      "timeout": "5m",
      "tags": ["linux", "netty", "http3", "quic", "tls13", "alpn", "payload-1024"]
    }
  ]
}
