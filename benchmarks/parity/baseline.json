{
  "name": "gnalloy external parity baseline",
  "notes": "同机外部对标基线。Netty、gnet、netpoll 场景默认 skip，安装对应 harness 后再设为 false。",
  "variables": {
    "REPO_ROOT": "../..",
    "GO": "go",
    "PAYLOAD": "1024",
    "CONNECTIONS": "256",
    "MESSAGES": "100000",
    "NETTY_BENCH_JAR": "./external/netty-bench.jar",
    "GNET_BENCH": "./external/gnet-bench",
    "NETPOLL_BENCH": "./external/netpoll-bench"
  },
  "scenarios": [
    {
      "name": "gnalloy tcp echo",
      "framework": "gnalloy",
      "protocol": "tcp-echo",
      "backend": "default",
      "payload": "${PAYLOAD}B",
      "workDir": "${REPO_ROOT}",
      "command": [
        "${GO}",
        "test",
        "-run",
        "^$",
        "-bench",
        "BenchmarkNativeTCPEchoRoundTrip$",
        "-benchmem",
        "./transport/tcp"
      ],
      "env": {
        "GOWORK": "off",
        "GNALLOY_BENCH_BACKEND": "default",
        "GNALLOY_BENCH_PAYLOAD": "${PAYLOAD}"
      },
      "timeout": "2m",
      "tags": ["local", "tcp", "echo"]
    },
    {
      "name": "gnalloy quic runtime",
      "framework": "gnalloy",
      "protocol": "quic-runtime",
      "backend": "pure-go",
      "payload": "${PAYLOAD}B",
      "workDir": "${REPO_ROOT}",
      "command": [
        "${GO}",
        "test",
        "-run",
        "^$",
        "-bench",
        "BenchmarkQUICRuntimeApplyACK|BenchmarkQUICRuntimeReceiveStream",
        "-benchmem",
        "./transport/quic"
      ],
      "env": {
        "GOWORK": "off"
      },
      "timeout": "2m",
      "tags": ["local", "quic", "runtime"]
    },
    {
      "name": "gnalloy udp endpoint backpressure",
      "framework": "gnalloy",
      "protocol": "udp-endpoint",
      "backend": "default",
      "payload": "${PAYLOAD}B",
      "workDir": "${REPO_ROOT}",
      "command": [
        "${GO}",
        "test",
        "-run",
        "^$",
        "-bench",
        "BenchmarkEndpointBackpressureQueue$",
        "-benchmem",
        "./transport/udp"
      ],
      "env": {
        "GOWORK": "off"
      },
      "timeout": "2m",
      "tags": ["local", "udp", "endpoint"]
    },
    {
      "name": "gnalloy raw endpoint backpressure",
      "framework": "gnalloy",
      "protocol": "raw-endpoint",
      "backend": "default",
      "payload": "${PAYLOAD}B",
      "workDir": "${REPO_ROOT}",
      "command": [
        "${GO}",
        "test",
        "-run",
        "^$",
        "-bench",
        "BenchmarkEndpointBackpressureQueue$",
        "-benchmem",
        "./transport/raw"
      ],
      "env": {
        "GOWORK": "off"
      },
      "timeout": "2m",
      "tags": ["local", "raw", "endpoint"]
    },
    {
      "name": "gnalloy quic frame codec",
      "framework": "gnalloy",
      "protocol": "quic-frame",
      "backend": "pure-go",
      "payload": "${PAYLOAD}B",
      "workDir": "${REPO_ROOT}",
      "command": [
        "${GO}",
        "test",
        "-run",
        "^$",
        "-bench",
        "Benchmark(FrameScanner|EncodeFrames)$",
        "-benchmem",
        "./transport/quic"
      ],
      "env": {
        "GOWORK": "off"
      },
      "timeout": "2m",
      "tags": ["local", "quic", "codec"]
    },
    {
      "name": "gnalloy l2 driver runtime",
      "framework": "gnalloy",
      "protocol": "l2-frame",
      "backend": "driver",
      "payload": "${PAYLOAD}B",
      "skip": true,
      "skipReason": "L2 runtime benchmark requires a privileged native host and an AF_PACKET/BPF/Npcap driver target",
      "tags": ["local", "l2", "privileged"]
    },
    {
      "name": "netty tcp echo",
      "framework": "netty",
      "protocol": "tcp-echo",
      "backend": "nio-or-native",
      "payload": "${PAYLOAD}B",
      "command": [
        "java",
        "-jar",
        "${NETTY_BENCH_JAR}",
        "--protocol",
        "tcp-echo",
        "--payload",
        "${PAYLOAD}",
        "--connections",
        "${CONNECTIONS}",
        "--messages",
        "${MESSAGES}"
      ],
      "timeout": "5m",
      "skip": true,
      "skipReason": "安装 Netty benchmark harness 后将 skip 改为 false",
      "tags": ["external", "netty", "tcp", "echo"]
    },
    {
      "name": "gnet tcp echo",
      "framework": "gnet",
      "protocol": "tcp-echo",
      "backend": "poller",
      "payload": "${PAYLOAD}B",
      "command": [
        "${GNET_BENCH}",
        "-protocol",
        "tcp-echo",
        "-payload",
        "${PAYLOAD}",
        "-connections",
        "${CONNECTIONS}",
        "-messages",
        "${MESSAGES}"
      ],
      "timeout": "5m",
      "skip": true,
      "skipReason": "安装 gnet benchmark harness 后将 skip 改为 false",
      "tags": ["external", "gnet", "tcp", "echo"]
    },
    {
      "name": "netpoll tcp echo",
      "framework": "netpoll",
      "protocol": "tcp-echo",
      "backend": "poller",
      "payload": "${PAYLOAD}B",
      "command": [
        "${NETPOLL_BENCH}",
        "-protocol",
        "tcp-echo",
        "-payload",
        "${PAYLOAD}",
        "-connections",
        "${CONNECTIONS}",
        "-messages",
        "${MESSAGES}"
      ],
      "timeout": "5m",
      "skip": true,
      "skipReason": "安装 netpoll benchmark harness 后将 skip 改为 false",
      "tags": ["external", "netpoll", "tcp", "echo"]
    }
  ]
}
