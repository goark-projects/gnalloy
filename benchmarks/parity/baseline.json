{
  "name": "gnalloy external parity baseline",
  "notes": "同机外部对标基线。运行前先构建 benchmarks/external/bin 下的 gnalloy、Netty、gnet、netpoll harness。",
  "variables": {
    "REPO_ROOT": ".",
    "GO": "go",
    "PAYLOAD": "1024",
    "CONNECTIONS": "256",
    "MESSAGES": "100000",
    "GNALLOY_BENCH": "./benchmarks/external/bin/gnalloy-bench",
    "NETTY_BENCH_JAR": "./benchmarks/external/bin/netty-bench.jar",
    "GNET_BENCH": "./benchmarks/external/bin/gnet-bench",
    "NETPOLL_BENCH": "./benchmarks/external/bin/netpoll-bench"
  },
  "scenarios": [
    {
      "name": "gnalloy tcp echo",
      "framework": "gnalloy",
      "protocol": "tcp-echo",
      "backend": "default",
      "payload": "${PAYLOAD}B",
      "workDir": "${REPO_ROOT}",
      "command": [
        "${GNALLOY_BENCH}",
        "-protocol",
        "tcp-echo",
        "-payload",
        "${PAYLOAD}",
        "-connections",
        "${CONNECTIONS}",
        "-messages",
        "${MESSAGES}",
        "-backend",
        "default"
      ],
      "timeout": "5m",
      "tags": ["local", "parity-harness", "tcp", "echo"]
    },
    {
      "name": "gnalloy udp endpoint backpressure",
      "framework": "gnalloy",
      "protocol": "udp-endpoint",
      "backend": "default",
      "payload": "${PAYLOAD}B",
      "workDir": "${REPO_ROOT}",
      "command": [
        "${GO}",
        "test",
        "-run",
        "^$",
        "-bench",
        "BenchmarkEndpointBackpressureQueue$",
        "-benchmem",
        "./transport/udp"
      ],
      "env": {
        "GOWORK": "off"
      },
      "timeout": "2m",
      "tags": ["local", "udp", "endpoint"]
    },
    {
      "name": "gnalloy raw endpoint backpressure",
      "framework": "gnalloy",
      "protocol": "raw-endpoint",
      "backend": "default",
      "payload": "${PAYLOAD}B",
      "workDir": "${REPO_ROOT}",
      "command": [
        "${GO}",
        "test",
        "-run",
        "^$",
        "-bench",
        "BenchmarkEndpointBackpressureQueue$",
        "-benchmem",
        "./transport/raw"
      ],
      "env": {
        "GOWORK": "off"
      },
      "timeout": "2m",
      "tags": ["local", "raw", "endpoint"]
    },
    {
      "name": "gnalloy l2 driver runtime",
      "framework": "gnalloy",
      "protocol": "l2-frame",
      "backend": "driver",
      "payload": "${PAYLOAD}B",
      "skip": true,
      "skipReason": "L2 runtime benchmark requires a privileged native host and an AF_PACKET/BPF/Npcap driver target",
      "tags": ["local", "l2", "privileged"]
    },
    {
      "name": "netty tcp echo epoll",
      "framework": "netty",
      "protocol": "tcp-echo",
      "backend": "epoll",
      "payload": "${PAYLOAD}B",
      "command": [
        "java",
        "-jar",
        "${NETTY_BENCH_JAR}",
        "--backend",
        "epoll",
        "--protocol",
        "tcp-echo",
        "--payload",
        "${PAYLOAD}",
        "--connections",
        "${CONNECTIONS}",
        "--messages",
        "${MESSAGES}"
      ],
      "timeout": "5m",
      "tags": ["external", "netty", "tcp", "echo"]
    },
    {
      "name": "gnet tcp echo",
      "framework": "gnet",
      "protocol": "tcp-echo",
      "backend": "poller",
      "payload": "${PAYLOAD}B",
      "command": [
        "${GNET_BENCH}",
        "-protocol",
        "tcp-echo",
        "-payload",
        "${PAYLOAD}",
        "-connections",
        "${CONNECTIONS}",
        "-messages",
        "${MESSAGES}"
      ],
      "timeout": "5m",
      "tags": ["external", "gnet", "tcp", "echo"]
    },
    {
      "name": "netpoll tcp echo",
      "framework": "netpoll",
      "protocol": "tcp-echo",
      "backend": "poller",
      "payload": "${PAYLOAD}B",
      "command": [
        "${NETPOLL_BENCH}",
        "-protocol",
        "tcp-echo",
        "-payload",
        "${PAYLOAD}",
        "-connections",
        "${CONNECTIONS}",
        "-messages",
        "${MESSAGES}"
      ],
      "timeout": "5m",
      "tags": ["external", "netpoll", "tcp", "echo"]
    }
  ]
}
